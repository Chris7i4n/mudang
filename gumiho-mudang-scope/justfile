_default:
    @just --list

# Debug build
build:
    cargo build

# Release build (lto thin, faster to compile)
release:
    cargo build --release

# Aggressive release build (lto fat + codegen-units=1, slower to compile, ~3% faster runtime)
fast:
    cargo build --profile release-fast

# Run scope using release-fast build
run *args:
    cargo run --profile release-fast -- {{args}}

# Install to ~/.cargo/bin using release-fast profile
install:
    cargo install --path . --profile release-fast --locked --force

# Run all tests (release)
test *args:
    cargo test --release {{args}}

# Run a single integration test by name
test-one name:
    cargo test --release --test {{name}}

# Format check
fmt-check:
    cargo fmt --check

# Apply formatting
fmt:
    cargo fmt

# Clippy with warnings as errors
clippy:
    cargo clippy --workspace --all-targets -- -D warnings

# Full gate: fmt-check + clippy + test
gate: fmt-check clippy test

# Clean target
clean:
    cargo clean

# Hyperfine bench on Rails sandbox (release-fast). Path overridable.
bench-rails path='/Users/athena/Projects/Personal/scope-rails-bench/rails': fast
    cd {{path}} && hyperfine --warmup 1 --runs 3 \
        --prepare 'rm -rf .scope && {{justfile_directory()}}/target/release-fast/scope init >/dev/null 2>&1' \
        '{{justfile_directory()}}/target/release-fast/scope index --full'
